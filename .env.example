# Supabase (public anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Optional; defaults to the production Hono API.
# VITE_AI_API_URL=http://localhost:8080/api/v1

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Analytics stays off when empty.
VITE_GA_ID=

# Optional: point the dev proxy at a local Go service (`go run ./cmd/api`).
# GO_API_URL=http://localhost:8080

# Netlify Functions (upload/feedback). Supabase falls back to the VITE_ values.
# SUPABASE_URL=
# SUPABASE_KEY=
RESEND_API_KEY=
UPLOAD_NOTIFICATION_TO=
# UPLOAD_NOTIFICATION_FROM="LiU Tentor <notifications@liutentor.se>"
# UPLOAD_REVIEW_URL=https://admin.liutentor.se/admin/review

# Sitemap cache invalidation webhook. NUXT_REVALIDATE_SECRET is also accepted
# during migration so the existing Netlify variable can remain in use.
# REVALIDATE_SECRET=
# NETLIFY_PURGE_API_TOKEN=
